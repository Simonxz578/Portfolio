---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  meta?: string[];
  variant?: string;
}

const { eyebrow, title, intro, meta = [], variant = "" } = Astro.props;
import { withBase } from "../utils/urls";
---

<section class:list={["page-hero", variant && `page-hero-${variant}`]}>
  <img class="page-hero-background" src={withBase("/images/v2/cambridge-paper.webp")} width="1086" height="725" alt="" aria-hidden="true" fetchpriority="high" />
  <div class="shell page-hero-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
    </div>
    <div class="page-hero-copy">
      <p>{intro}</p>
      {
        meta.length > 0 && (
          <ul class="meta-list" aria-label="Page details">
            {meta.map((item) => <li>{item}</li>)}
          </ul>
        )
      }
    </div>
  </div>
</section>
