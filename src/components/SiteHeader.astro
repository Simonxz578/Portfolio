---
import { site } from "@data/site";
import { withBase } from "../utils/urls";

interface Props {
  currentPath: string;
  locale?: "en-GB" | "zh-CN";
}

const { currentPath, locale = "en-GB" } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const logicalPath =
  basePath && currentPath.startsWith(basePath)
    ? currentPath.slice(basePath.length) || "/"
    : currentPath;

function isCurrent(href: string): boolean {
  return logicalPath === href || (href !== "/" && logicalPath.startsWith(href));
}

const isZh = locale === "zh-CN";
const switchablePath = /(?:^|\/)404(?:\.html)?\/?$/.test(logicalPath) ? "/" : logicalPath;
const englishPath = switchablePath.startsWith("/zh/") ? switchablePath.slice(3) || "/" : switchablePath;
const chinesePath = switchablePath.startsWith("/zh/") ? switchablePath : `/zh${switchablePath}`;
const onePage = ["/", "/zh/", "/resume/", "/zh/resume/"].includes(logicalPath);
const navigation = onePage ? [
  {label:isZh?"项目":"Projects",href:"#resume-projects"},
  {label:isZh?"研究":"Research",href:"#resume-research"},
  {label:isZh?"履历":"Résumé",href:"#resume-start"},
  {label:isZh?"联系":"Contact",href:"#resume-contact"}
] : isZh ? [
  {label:"项目",href:"/zh/work/"},{label:"研究",href:"/zh/research/"},{label:"领导力",href:"/zh/leadership/"},
  {label:"关于我",href:"/zh/about/"},{label:"履历",href:"/zh/resume/"},{label:"联系",href:"/zh/contact/"}
] : site.navigation;
---

<header class="site-header is-light" data-site-header data-onepage-nav={onePage ? "true" : undefined}>
  <div class="shell header-inner">
    <a class="identity" href={withBase(isZh ? "/zh/" : "/")} aria-label={isZh ? "张翔—首页" : "Xiang Zhang — home"}>
      <span class="identity-mark" aria-hidden="true">XZ</span>
      <span class="identity-copy">
        <strong>{isZh ? "张翔 Simon" : "Xiang Zhang"}</strong>
        <span>{isZh ? "AI 产品与应用 AI" : "AI Product & Applied AI"}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-nav-toggle
    >
      <span data-nav-label>{isZh ? "菜单" : "Menu"}</span>
      <span class="nav-toggle-lines" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label={isZh ? "主导航" : "Primary navigation"} data-nav-panel>
      {
        navigation.map((item) => (
          <a href={item.href.startsWith("#") ? item.href : withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <div class="language-switch" aria-label={isZh ? "语言选择" : "Language selection"}>
        <a href={withBase(chinesePath)} data-language-link data-language-base={withBase(chinesePath)} lang="zh-CN" aria-current={isZh ? "page" : undefined}>中文</a>
        <span aria-hidden="true">/</span>
        <a href={withBase(englishPath)} data-language-link data-language-base={withBase(englishPath)} lang="en-GB" aria-current={!isZh ? "page" : undefined}>EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-nav-panel]");
  const label = document.querySelector<HTMLElement>("[data-nav-label]");
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const panelLinks = Array.from(panel?.querySelectorAll<HTMLAnchorElement>("a") ?? []);
  const focusTargets = toggle ? [toggle, ...panelLinks] : panelLinks;
  const pageRegions = Array.from(document.querySelectorAll<HTMLElement>("main, .site-footer"));
  const chinese = document.documentElement.lang === "zh-CN";
  let menuOpen = toggle?.getAttribute("aria-expanded") === "true";

  function setOpen(open: boolean, returnFocus = false): void {
    if (!toggle || !panel) return;
    if (open !== menuOpen) {
      menuOpen = open;
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("is-open", open);
      document.body.classList.toggle("nav-open", open);
      if (label) label.textContent = open ? (chinese ? "关闭" : "Close") : (chinese ? "菜单" : "Menu");
      pageRegions.forEach(region => { region.inert = open; });
      invalidateGeometry();
      if (open) panelLinks[0]?.focus();
    }
    if (!open && returnFocus) toggle.focus();
  }

  toggle?.addEventListener("click", () => setOpen(!menuOpen));
  panel?.addEventListener("click", event => {
    if (event.target instanceof Element && event.target.closest("a")) setOpen(false);
  });
  document.addEventListener("click", event => {
    if (menuOpen && event.target instanceof Node && !toggle?.contains(event.target) && !panel?.contains(event.target)) setOpen(false);
  });
  document.addEventListener("keydown", event => {
    if (event.key === "Tab" && menuOpen && panel) {
      const first = focusTargets[0];
      const last = focusTargets[focusTargets.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
    if (event.key === "Escape" && menuOpen) setOpen(false, true);
  });
  const desktop = window.matchMedia("(min-width: 1101px)");
  desktop.addEventListener("change", () => setOpen(false));

  const onePage = header?.dataset.onepageNav === "true";
  const darkScene = document.querySelector<HTMLElement>(".cosmic-run, .work-intro, .ninefold-hero");
  const sceneViewport = darkScene?.querySelector<HTMLElement>("[data-cosmic-viewport]");
  const readingSections = Array.from(document.querySelectorAll<HTMLElement>(".one-page-resume > section[id]"));
  const languageLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-language-link]"));
  const anchorLinks = panelLinks.filter(link => link.getAttribute("href")?.startsWith("#"));
  const readingInset = 190;
  type ReadingGeometry = { element: HTMLElement; top: number; height: number };
  let geometry: ReadingGeometry[] = [];
  let sceneGeometry: { top: number; bottom: number; height: number; viewport: number } | undefined;
  let layoutWidth = 0;
  let geometryDirty = true;
  let currentReading: ReadingGeometry | undefined;
  let readingFraction = 0;
  let pendingRestore: { id: string; fraction: number } | undefined;
  let pendingResize: { id: string; fraction: number; width: number; sections: ReadingGeometry[] } | undefined;
  let headerFrame = 0;
  let activeReadingId: string | undefined;
  let scrolledState = header?.classList.contains("is-scrolled") ?? false;
  let lightState = header?.classList.contains("is-light") ?? false;
  let opacityState = Number(header?.style.opacity || "1");
  let inertState = header?.inert ?? false;

  // All layout reads happen together, only after a layout-affecting event.
  function measureGeometry(): void {
    const scrollY = window.scrollY;
    const rect = darkScene?.getBoundingClientRect();
    sceneGeometry = rect && darkScene ? {
      top: rect.top + scrollY,
      bottom: rect.bottom + scrollY,
      height: darkScene.offsetHeight,
      viewport: sceneViewport?.offsetHeight || window.innerHeight
    } : undefined;
    geometry = readingSections.map(element => ({ element, top: element.getBoundingClientRect().top + scrollY, height: element.offsetHeight }));
    layoutWidth = document.documentElement.clientWidth || window.innerWidth;
    geometryDirty = false;
  }
  function readingLayoutChanged(previous: { width: number; sections: ReadingGeometry[] }): boolean {
    if (Math.abs(layoutWidth - previous.width) > .5 || geometry.length !== previous.sections.length) return true;
    return geometry.some((section, index) => {
      const before = previous.sections[index];
      return !before || before.element !== section.element || Math.abs(before.top - section.top) > .5 || Math.abs(before.height - section.height) > .5;
    });
  }
  function readingAt(scrollY: number): ReadingGeometry | undefined {
    let current: ReadingGeometry | undefined;
    for (const section of geometry) if (section.top <= scrollY + readingInset) current = section;
    return current;
  }
  function updateHeader(): void {
    headerFrame = 0;
    if (document.hidden) return;
    if (geometryDirty) measureGeometry();
    let scrollY = window.scrollY;
    let restoreTop: number | undefined;
    const restore = pendingRestore || (pendingResize && readingLayoutChanged(pendingResize) ? pendingResize : undefined);
    pendingRestore = undefined;
    pendingResize = undefined;
    if (restore) {
      const target = geometry.find(section => section.element.id === restore.id);
      if (target) restoreTop = Math.max(0, target.top + restore.fraction * target.height - readingInset);
    }
    // Geometry is already cached before any scroll or DOM writes.
    if (restoreTop !== undefined && Math.abs(scrollY - restoreTop) > .5) {
      window.scrollTo({top:restoreTop,behavior:"instant"});
      scrollY = window.scrollY;
    }
    const sceneBottom = sceneGeometry ? sceneGeometry.bottom - scrollY : 0;
    const scenePassed = !sceneGeometry || sceneBottom < 100;
    const cosmic = darkScene?.matches(".cosmic-run[data-cosmic-enhanced]") ?? false;
    const progress = cosmic && sceneGeometry ? Math.max(0,Math.min(1,(scrollY - sceneGeometry.top) / Math.max(1,sceneGeometry.height-sceneGeometry.viewport))) : 0;
    const paleScene = cosmic && progress > .61;
    const whitening = cosmic && sceneGeometry && sceneBottom >= sceneGeometry.viewport - 1;
    const opacity = whitening ? 1 - Math.max(0,Math.min(1,(progress-.91)/.05)) : 1;
    const inert = opacity < .01;
    const morningScene = darkScene?.dataset.cosmicTheme === "morning" || darkScene?.dataset.headerTone === "light";
    const light = scenePassed || paleScene || morningScene;
    const scrolled = scrollY > 8;
    currentReading = onePage ? readingAt(scrollY) : undefined;
    if (currentReading) readingFraction = Math.max(0,Math.min(1,(scrollY + readingInset - currentReading.top) / Math.max(1,currentReading.height)));

    if (header) {
      if (scrolled !== scrolledState) { header.classList.toggle("is-scrolled", scrolled); scrolledState = scrolled; }
      if (light !== lightState) { header.classList.toggle("is-light", light); lightState = light; }
      if (opacity !== opacityState) { header.style.opacity = String(opacity); opacityState = opacity; }
      if (inert !== inertState) { header.inert = inert; inertState = inert; }
    }
    if (!onePage) return;
    const id = currentReading?.element.id || "";
    if (id === activeReadingId) return;
    activeReadingId = id;
    anchorLinks.forEach(link => {
      if (link.hash === "#" + id) {
        if (link.getAttribute("aria-current") !== "location") link.setAttribute("aria-current", "location");
      } else if (link.hasAttribute("aria-current")) link.removeAttribute("aria-current");
    });
    languageLinks.forEach(link => {
      const href = (link.dataset.languageBase || "") + (id ? "#" + id : "");
      if (link.getAttribute("href") !== href) link.setAttribute("href", href);
    });
  }
  function scheduleHeader(): void {
    if (!headerFrame && !document.hidden) headerFrame = requestAnimationFrame(updateHeader);
  }
  function invalidateGeometry(): void { geometryDirty = true; scheduleHeader(); }
  function cancelHeaderFrame(): void { if (headerFrame) cancelAnimationFrame(headerFrame); headerFrame = 0; }
  const restoreReadingAfterResize = () => {
    // Mobile chrome/keyboards may resize the viewport while the document layout stays put.
    if (onePage && currentReading && !pendingRestore && !pendingResize) {
      pendingResize = {id:currentReading.element.id,fraction:readingFraction,width:layoutWidth,sections:geometry};
    }
    invalidateGeometry();
  };
  languageLinks.forEach(link => link.addEventListener("click", () => {
    if (!onePage) return;
    if (geometryDirty) measureGeometry();
    const current = readingAt(window.scrollY);
    const href = (link.dataset.languageBase || "") + (current ? "#" + current.element.id : "");
    if (link.getAttribute("href") !== href) link.setAttribute("href", href);
    if (!current) return;
    const fraction = Math.max(0,Math.min(1,(window.scrollY + readingInset - current.top) / Math.max(1,current.height)));
    try { sessionStorage.setItem("portfolio-reading-position", JSON.stringify({path:new URL(link.href).pathname,id:current.element.id,fraction})); } catch { /* Anchors remain the fallback. */ }
  }));
  try {
    const raw = sessionStorage.getItem("portfolio-reading-position");
    if (raw) {
      const saved = JSON.parse(raw) as {path:string;id:string;fraction:number};
      sessionStorage.removeItem("portfolio-reading-position");
      if (onePage && saved.path === window.location.pathname && window.location.hash === "#" + saved.id) {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          pendingRestore = {id:saved.id,fraction:Math.max(0,Math.min(1,saved.fraction))};
          geometryDirty = true;
          cancelHeaderFrame();
          updateHeader();
        }));
      }
    }
  } catch { /* A disabled storage API does not prevent navigation. */ }

  if ("ResizeObserver" in window) {
    const sizeObserver = new ResizeObserver(invalidateGeometry);
    const targets = new Set<HTMLElement>([document.documentElement, ...readingSections]);
    if (darkScene) targets.add(darkScene);
    if (sceneViewport) targets.add(sceneViewport);
    targets.forEach(target => sizeObserver.observe(target));
  }
  if (darkScene && "MutationObserver" in window) {
    const sceneObserver = new MutationObserver(invalidateGeometry);
    sceneObserver.observe(darkScene, {attributes:true,attributeFilter:["data-cosmic-enhanced","data-cosmic-theme","data-header-tone"]});
  }
  const onImageLayout = (event: Event) => { if (event.target instanceof HTMLImageElement) invalidateGeometry(); };
  document.addEventListener("load", onImageLayout, true);
  document.addEventListener("error", onImageLayout, true);
  document.fonts?.ready.then(invalidateGeometry);
  document.fonts?.addEventListener("loadingdone", invalidateGeometry);
  document.addEventListener("visibilitychange", () => { if (document.hidden) cancelHeaderFrame(); else invalidateGeometry(); });
  window.addEventListener("scroll", scheduleHeader, {passive:true});
  window.addEventListener("resize", restoreReadingAfterResize, {passive:true});
  window.addEventListener("hashchange", scheduleHeader);
  window.addEventListener("pageshow", invalidateGeometry);
  window.addEventListener("pagehide", cancelHeaderFrame);
  updateHeader();
</script>
