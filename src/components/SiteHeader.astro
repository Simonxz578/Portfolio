---
import { site } from "@data/site";
import { withBase } from "../utils/urls";

interface Props {
  currentPath: string;
  locale?: "en-GB" | "zh-CN";
}

const { currentPath, locale = "en-GB" } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const logicalPath =
  basePath && currentPath.startsWith(basePath)
    ? currentPath.slice(basePath.length) || "/"
    : currentPath;

function isCurrent(href: string): boolean {
  return logicalPath === href || (href !== "/" && logicalPath.startsWith(href));
}

const isZh = locale === "zh-CN";
const switchablePath = /(?:^|\/)404(?:\.html)?\/?$/.test(logicalPath) ? "/" : logicalPath;
const englishPath = switchablePath.startsWith("/zh/") ? switchablePath.slice(3) || "/" : switchablePath;
const chinesePath = switchablePath.startsWith("/zh/") ? switchablePath : `/zh${switchablePath}`;
const onePage = ["/", "/zh/", "/resume/", "/zh/resume/"].includes(logicalPath);
const navigation = onePage ? [
  {label:isZh?"项目":"Projects",href:"#resume-projects"},
  {label:isZh?"研究":"Research",href:"#resume-research"},
  {label:isZh?"履历":"Résumé",href:"#resume-start"},
  {label:isZh?"联系":"Contact",href:"#resume-contact"}
] : isZh ? [
  {label:"项目",href:"/zh/work/"},{label:"研究",href:"/zh/research/"},{label:"领导力",href:"/zh/leadership/"},
  {label:"关于我",href:"/zh/about/"},{label:"履历",href:"/zh/resume/"},{label:"联系",href:"/zh/contact/"}
] : site.navigation;
---

<header class="site-header is-light" data-site-header data-onepage-nav={onePage ? "true" : undefined}>
  <div class="shell header-inner">
    <a class="identity" href={withBase(isZh ? "/zh/" : "/")} aria-label={isZh ? "张翔—首页" : "Xiang Zhang — home"}>
      <span class="identity-mark" aria-hidden="true">XZ</span>
      <span class="identity-copy">
        <strong>{isZh ? "张翔 Simon" : "Xiang Zhang"}</strong>
        <span>{isZh ? "AI 产品与应用 AI" : "AI Product & Applied AI"}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-nav-toggle
    >
      <span data-nav-label>{isZh ? "菜单" : "Menu"}</span>
      <span class="nav-toggle-lines" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label={isZh ? "主导航" : "Primary navigation"} data-nav-panel>
      {
        navigation.map((item) => (
          <a href={item.href.startsWith("#") ? item.href : withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <div class="language-switch" aria-label={isZh ? "语言选择" : "Language selection"}>
        <a href={withBase(chinesePath)} data-language-link data-language-base={withBase(chinesePath)} lang="zh-CN" aria-current={isZh ? "page" : undefined}>中文</a>
        <span aria-hidden="true">/</span>
        <a href={withBase(englishPath)} data-language-link data-language-base={withBase(englishPath)} lang="en-GB" aria-current={!isZh ? "page" : undefined}>EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-nav-panel]");
  const label = document.querySelector<HTMLElement>("[data-nav-label]");
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  function setOpen(open: boolean, returnFocus = false): void {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.classList.toggle("is-open", open);
    document.body.classList.toggle("nav-open", open);
    if (label) label.textContent = open ? (document.documentElement.lang === "zh-CN" ? "关闭" : "Close") : (document.documentElement.lang === "zh-CN" ? "菜单" : "Menu");
    document.querySelectorAll<HTMLElement>("main, .site-footer").forEach((region) => region.inert = open);
    if (open) panel.querySelector<HTMLAnchorElement>("a")?.focus();
    if (!open && returnFocus) toggle.focus();
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  panel?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) {
      setOpen(false);
    }
  });

  document.addEventListener("click", (event) => {
    if (
      toggle?.getAttribute("aria-expanded") === "true" &&
      event.target instanceof Node &&
      !toggle.contains(event.target) &&
      !panel?.contains(event.target)
    ) {
      setOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Tab" && toggle?.getAttribute("aria-expanded") === "true" && panel) {
      const targets = [toggle, ...panel.querySelectorAll<HTMLAnchorElement>("a")];
      const first = targets[0]; const last = targets[targets.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false, true);
    }
  });

  const desktop = window.matchMedia("(min-width: 1101px)");
  desktop.addEventListener("change", () => setOpen(false));

  const onePage = header?.dataset.onepageNav === "true";
  const darkScene = document.querySelector<HTMLElement>(".cosmic-run, .work-intro, .ninefold-hero");
  const readingSections = Array.from(document.querySelectorAll<HTMLElement>(".one-page-resume > section[id]"));
  const languageLinks = document.querySelectorAll<HTMLAnchorElement>("[data-language-link]");
  let currentSection: HTMLElement | undefined;
  let readingFraction = 0;
  let headerFrame = 0;
  function updateHeader(): void {
    headerFrame = 0;
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
    const sceneRect = darkScene?.getBoundingClientRect();
    const scenePassed = !sceneRect || sceneRect.bottom < 100;
    const cosmic = darkScene?.matches(".cosmic-run[data-cosmic-enhanced]");
    const stageHeight = darkScene?.querySelector<HTMLElement>("[data-cosmic-viewport]")?.offsetHeight || window.innerHeight;
    const progress = cosmic && sceneRect && darkScene ? Math.max(0,Math.min(1,-sceneRect.top / Math.max(1,darkScene.offsetHeight-stageHeight))) : 0;
    const paleScene = cosmic && progress > .61;
    const whitening = cosmic && sceneRect && sceneRect.bottom >= stageHeight - 1;
    const headerOpacity = whitening ? 1 - Math.max(0,Math.min(1,(progress-.91)/.05)) : 1;
    if (header) { header.style.opacity = String(headerOpacity); header.inert = headerOpacity < .01; }
    const morningScene = darkScene?.dataset.cosmicTheme === "morning" || darkScene?.dataset.headerTone === "light";
    header?.classList.toggle("is-light", scenePassed || !!paleScene || morningScene);
    if (!onePage) return;
    currentSection = undefined;
    for (const section of readingSections) {
      if (section.getBoundingClientRect().top <= 190) currentSection = section;
    }
    if (currentSection) readingFraction = Math.max(0, Math.min(1, (190 - currentSection.getBoundingClientRect().top) / Math.max(1, currentSection.offsetHeight)));
    panel?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      if (link.hash === "#" + currentSection?.id) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
    languageLinks.forEach(link => { link.href = (link.dataset.languageBase || "") + (currentSection ? "#" + currentSection.id : ""); });
  }
  const scheduleHeader = () => { if (!headerFrame) headerFrame = requestAnimationFrame(updateHeader); };
  const restoreReadingAfterResize = () => {
    if (onePage && currentSection) {
      const target = currentSection.getBoundingClientRect().top + window.scrollY + readingFraction * currentSection.offsetHeight - 190;
      window.scrollTo({top:Math.max(0,target),behavior:"instant"});
    }
    scheduleHeader();
  };
  languageLinks.forEach(link => link.addEventListener("click", () => {
    if (!onePage || !currentSection) return;
    const top = currentSection.getBoundingClientRect().top + window.scrollY;
    const readingInset = 190;
    const fraction = Math.max(0, Math.min(1, (window.scrollY + readingInset - top) / Math.max(1, currentSection.offsetHeight)));
    try { sessionStorage.setItem("portfolio-reading-position", JSON.stringify({path:new URL(link.href).pathname,id:currentSection.id,fraction})); } catch { /* Anchors remain the fallback. */ }
  }));
  try {
    const raw = sessionStorage.getItem("portfolio-reading-position");
    if (raw) {
      const saved = JSON.parse(raw) as {path:string;id:string;fraction:number};
      sessionStorage.removeItem("portfolio-reading-position");
      if (onePage && saved.path === window.location.pathname && window.location.hash === "#" + saved.id) {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          const section = document.getElementById(saved.id);
          if (section) window.scrollTo({top:Math.max(0,section.getBoundingClientRect().top + window.scrollY + Math.max(0,Math.min(1,saved.fraction))*section.offsetHeight - 190),behavior:"instant"});
          scheduleHeader();
        }));
      }
    }
  } catch { /* A disabled storage API does not prevent navigation. */ }
  updateHeader();
  window.addEventListener("scroll", scheduleHeader, {passive:true});
  window.addEventListener("resize", restoreReadingAfterResize, {passive:true});
  window.addEventListener("pageshow", scheduleHeader);
</script>
