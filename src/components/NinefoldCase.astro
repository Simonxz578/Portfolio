---
import BaseLayout from "@layouts/BaseLayout.astro";
import "../styles/cases.css";
import { ninefoldLinks } from "@data/ninefold";
import { withBase } from "../utils/urls";
const { locale = "en" } = Astro.props;
const zh = locale === "zh";
const alternate = zh ? "/work/ninefold/" : "/zh/work/ninefold/";
const live = zh ? ninefoldLinks.zh : ninefoldLinks.en;
const productRoute = (route: string) => `https://ninefold-65f.pages.dev/#/${zh ? "zh" : "en"}/${route}`;
const media = {
  hero: withBase("/images/ninefold/ninefold-showcase.webp"),
  experiments: withBase("/images/ninefold/ninefold-experiments.webp"),
  maths: withBase("/images/ninefold/ninefold-maths.webp"),
  physics: withBase("/images/ninefold/ninefold-physics.webp"),
  dialogue: withBase("/images/ninefold/ninefold-dialogue.webp")
};
const c = zh ? {
  pageTitle: "九境生息 Ninefold｜角色互动与学习探索｜张翔 Simon",
  description: "Ninefold 将角色对话、语音输入、实验探索和物理与数学学习地图连接起来，形成一个可进入、可探索的学习世界。",
  eyebrow: "旗舰项目 · AI 学习产品",
  headline: "从一句话开始，让好奇心找到下一步。",
  intro: "九境生息把角色互动、语音输入、实验探索，以及物理与数学学习地图放进同一个世界。我关注的产品问题是：怎样让学习者愿意开始，又能从一次对话走向可以观察、练习和验证的理解。",
  liveLabel: "体验 Ninefold",
  switchLabel: "English case",
  meta: [["我的角色", "独立产品负责人"], ["学习对象", "国际课程学习者与自主探索者"], ["产品范围", "角色对话 · 实验 · 物理与数学"], ["当前状态", "已上线的中英文公开 Beta"]],
  surfaces: ["和角色交流", "进入实验", "沿学科地图学习"],
  chapters: [["learning-loop", "产品问题"], ["teaching-paths", "角色与语音"], ["experiments", "实验探索"], ["physics-toolkit", "学科地图"], ["ai-boundaries", "产品编排"], ["case-status", "交付与验证"]]
} : {
  pageTitle: "Ninefold — A character-led learning world | Simon Zhang",
  description: "Ninefold connects character conversation, voice input, experiment exploration and structured physics and mathematics learning maps in one world.",
  eyebrow: "Flagship · AI learning product",
  headline: "Start a conversation. Give curiosity a next step.",
  intro: "Ninefold brings character interaction, voice input, experiments, and physics and mathematics learning maps into one world. My product question is how to make learning inviting to begin, then turn a conversation into understanding a learner can observe, practise and check.",
  liveLabel: "Experience Ninefold",
  switchLabel: "中文案例",
  meta: [["My role", "Independent product owner"], ["Audience", "International-curriculum and self-directed learners"], ["Product scope", "Characters · Experiments · Physics & Maths"], ["Status", "Live bilingual public beta"]],
  surfaces: ["Talk with a character", "Enter an experiment", "Follow a subject map"],
  chapters: [["learning-loop", "Product question"], ["teaching-paths", "Character & voice"], ["experiments", "Experiments"], ["physics-toolkit", "Subject maps"], ["ai-boundaries", "Orchestration"], ["case-status", "Delivery & validation"]]
};
const voiceSteps = zh ? [
  ["录音", "学习者用语音提出问题或说明思路。"],
  ["检查文字", "Whisper 转写后，学习者可以修改识别结果。"],
  ["确认提交", "学习场景按确认后的文字继续，而不是把识别结果直接当作答案。"],
  ["角色反馈", "通过角色文字气泡、状态和提示，把注意力带回当前问题。"]
] : [
  ["Record", "Ask a question or explain a line of reasoning by voice."],
  ["Review the text", "Whisper transcribes the recording into editable text."],
  ["Submit", "Learning flows continue from the confirmed text, rather than treating a recognition result as an answer."],
  ["Character feedback", "Text bubbles, character states and hints return attention to the current question."]
];
const labSteps = zh ? [
  ["预测", "先说出预期会发生什么。"], ["搭建", "选用仪器，并控制变量。"], ["测量", "改变一个量，观察模型读数。"], ["分析", "记录数据、调整坐标或进行线性拟合。"], ["评价", "检查方法、误差和结论。"]
] : [
  ["Predict", "State what you expect to happen."], ["Set up", "Choose apparatus and control variables."], ["Measure", "Change one variable and read the model."], ["Analyse", "Record data, transform axes or fit a line."], ["Evaluate", "Examine the method, uncertainty and conclusion."]
];
const orchestration = zh ? [
  ["学习情境", "把当前题目、已验证的方法与学习者确认后的问题一起送入受约束的流程。"],
  ["共享模型路由", "DeepSeek deepseek-flash 为主，GLM 4.7 Flash 提供受限回退；各类学习任务共用这一编排。"],
  ["限定模型权限", "题目辅导选择规范策略 ID；实验引导选择目录 ID 或提示卡；练习生成选择受约束的配方与种子。"],
  ["规则与内容交付", "系统组装经过编写的提示；计算、答案、分值和解答由确定性逻辑与内容定义负责。"]
] : [
  ["Learning context", "Bring the current question, verified method and learner’s confirmed question into a bounded flow."],
  ["Shared model routing", "DeepSeek deepseek-flash is primary; GLM 4.7 Flash is a bounded fallback. Learning features share this routing."],
  ["Limited model authority", "Question coaching selects canonical strategy IDs; lab guidance selects catalogue IDs or hint cards; practice generation selects bounded recipes and seeds."],
  ["Rules and authored delivery", "The system assembles authored hints. Deterministic logic and content definitions own calculations, answers, marks and solutions."]
];
---
<BaseLayout title={c.pageTitle} description={c.description} locale={zh ? "zh-CN" : "en-GB"}>
<article class="ninefold-case physics-case ninefold-current">
  <section class="ninefold-hero" aria-labelledby="physics-title" data-header-tone="light">
    <div class="shell">
      <nav class="case-hero-toolbar" aria-label={zh ? "案例导航" : "Case navigation"}>
        <a class="case-back-link" href={withBase(zh ? "/zh/work/" : "/work/")}><span aria-hidden="true">←</span> {zh ? "全部项目" : "All work"}</a>
        <a class="ninefold-language text-link" href={withBase(alternate)}>{c.switchLabel} <span aria-hidden="true">↗</span></a>
      </nav>
      <div class="ninefold-hero-layout">
        <div class="ninefold-hero-content">
          <p class="eyebrow">{c.eyebrow}</p>
          <h1 id="physics-title">Ninefold<span class="nf-chinese-name" lang="zh-CN">九境生息</span></h1>
          <h2>{c.headline}</h2>
          <p class="ninefold-intro">{c.intro}</p>
          <div class="button-row"><a class="button button-primary" href={live} target="_blank" rel="noopener noreferrer">{c.liveLabel} <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="#learning-loop">{zh ? "阅读产品案例" : "Read the product case"} <span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="ninefold-environment ninefold-screenshot-frame" aria-hidden="true"><img class="ninefold-showcase" src={media.hero} width="1920" height="1106" alt="" fetchpriority="high" decoding="async" /></div>
      </div>
      <ul class="nf-surface-list" aria-label={zh ? "三个产品入口" : "Three product entry points"}>{c.surfaces.map(x=><li>{x}</li>)}</ul>
    </div>
  </section>
  <section class="ninefold-ledger"><div class="shell"><dl>{c.meta.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></div></section>
  <nav class="case-chapter-nav shell" aria-label={zh ? "案例章节" : "Case chapters"}>{c.chapters.map(([id,label])=><a href={'#'+id}>{label}</a>)}</nav>

  <section class="case-section" id="learning-loop"><div class="shell nf-intent-grid">
    <header><p class="eyebrow">{zh ? "产品问题" : "The product question"}</p><h2>{zh ? "有了 AI 回答之后，学习为什么还需要一个产品？" : "When AI can answer, what should a learning product do?"}</h2></header>
    <div class="nf-reading"><p class="nf-lead">{zh ? "我把重点放在开始、下一步和证据：先降低表达的门槛，再让学习者看见自己正在理解什么。" : "I focused on the beginning, the next step and the evidence: make it easier to express a thought, then help learners see what they understand."}</p><p>{zh ? "角色和世界承担进入体验；对话承接好奇心；实验和学科路径把兴趣连接到可操作的学习任务。学习者可以从不同入口开始，产品则需要把这些入口连接到当前的学习情境。" : "The character and world provide an inviting entrance. Conversation carries curiosity; experiments and subject paths connect it to a concrete task. Learners can begin at different entry points, while the product connects those entrances to the current learning context."}</p><p>{zh ? "作为独立产品负责人，我把问题定义、交互设计、AI 权限、课程与实验规则、实现和上线验收放在同一条决策链上。物理与数学是当前结构化学习的落点；开放角色聊天与经过课程约束的教学功能分开呈现。" : "As the independent product owner, I connected problem framing, interaction design, AI authority, curriculum and experiment rules, implementation and release acceptance. Physics and mathematics are the current structured learning areas; open character conversation is distinct from curriculum-bounded teaching."}</p></div>
  </div></section>

  <section class="case-section case-section-tinted" id="teaching-paths"><div class="shell">
    <div class="case-wide-heading"><p class="section-number">{zh ? "角色与语音" : "CHARACTER & VOICE"}</p><div><h2>{zh ? "让学习者先说出思路，再决定需要什么帮助。" : "Let learners express their thinking before deciding what help they need."}</h2><p>{zh ? "Lyra 与 Elio 通过角色动画、文字对话与题目提示参与学习。语音在这里是输入方式：它帮助学习者提出问题、描述方法，也保留检查和修改的机会。" : "Lyra and Elio participate through character animation, text conversation and question-specific hints. Voice is an input method: it helps learners ask a question or describe a method while retaining a chance to review and edit."}</p></div></div>
    <ol class="nf-voice-flow">{voiceSteps.map(([label,detail],i)=><li><span>{String(i+1).padStart(2,'0')}</span><h3>{label}</h3><p>{detail}</p></li>)}</ol>
    <figure class="nf-evidence"><a href={media.dialogue} target="_blank" rel="noopener noreferrer" aria-label={zh ? "打开角色辅导与语音转写完整截图" : "Open the full character coaching and speech-to-text screenshot"}><img src={media.dialogue} width="1600" height="1000" loading="lazy" decoding="async" alt={zh ? "数学题中的艾里奥角色提示、可编辑提问区和语音转文字按钮" : "Elio's question-specific hint, editable question field and speech-to-text control in a mathematics lesson"}/><span class="nf-image-open" aria-hidden="true">↗</span></a><figcaption><span>{zh ? "逐题角色辅导 · 语音转文字后确认提交" : "Question-specific character coaching · Review speech-to-text before submitting"}</span><span>{zh ? "点击查看完整图片" : "Open the full image"}</span></figcaption></figure>
    <div class="nf-coach-decision"><div><p class="eyebrow">{zh ? "关键产品决策" : "A key product decision"}</p><h3>{zh ? "让角色的提示服务于下一步思考。" : "Make character hints serve the next step in thinking."}</h3></div><div class="nf-reading"><p>{zh ? "在题目辅导中，模型读取题目、已验证答案与方法，以及学习者确认后的提问，只选择规范的策略 ID。界面展示经过编写、不含答案的提示，并记录这次是否获得了支持。" : "In question coaching, the model receives the question, verified answer and method, and the learner’s confirmed question. It selects a canonical strategy ID; the interface returns an authored, answer-free hint and records whether support was used."}</p><details class="nf-detail"><summary>{zh ? "为什么把模型权限限制在策略选择？" : "Why limit the model to strategy selection?"}</summary><p>{zh ? "提示可以适应当前疑问，答案与判分则由题目定义和确定性检查负责。对话负责承接问题，经过编写的提示负责引导思考，反馈通过文字和角色状态呈现。" : "Hints can respond to the learner’s question while answer definitions and deterministic checks retain control of correctness and marking. Conversation carries the question; authored hints guide the reasoning, with feedback delivered through text and character states."}</p></details></div></div>
  </div></section>

  <section class="case-section" id="experiments"><div class="shell">
    <div class="case-wide-heading"><p class="section-number">{zh ? "实验探索" : "EXPERIMENT EXPLORATION"}</p><div><h2>{zh ? "把“我觉得”变成“我观察到了什么”。" : "Turn “I think” into “what did I observe?”"}</h2><p>{zh ? "实验库覆盖弹簧、伏安特性、自由落体、衰变、棱镜、干涉和光电效应等情境。学习者可以进入相应实验、调整变量、读取结果，并用数据检查自己的预测。" : "The library spans settings such as springs, I–V characteristics, free fall, decay, prisms, interference and the photoelectric effect. Learners enter an experiment, vary a quantity, read the result and compare it with their prediction."}</p></div></div>
    <figure class="nf-evidence"><a href={media.experiments} target="_blank" rel="noopener noreferrer" aria-label={zh ? "打开实验探索完整截图" : "Open the full experiment exploration screenshot"}><img src={media.experiments} width="1600" height="1000" loading="lazy" decoding="async" alt={zh ? "Ninefold 当前实验探索界面" : "The current Ninefold experiment exploration interface"}/><span class="nf-image-open" aria-hidden="true">↗</span></a><figcaption><span>{zh ? "实验探索 · 当前产品界面" : "Experiment exploration · Current product interface"}</span><span>{zh ? "点击查看完整图片" : "Open the full image"}</span></figcaption></figure>
    <div class="button-row"><a class="button button-secondary" href={productRoute("experiments")} target="_blank" rel="noopener noreferrer">{zh ? "进入实验探索" : "Explore the experiments"} <span aria-hidden="true">↗</span></a></div>
    <ol class="nf-lab-flow">{labSteps.map(([label,detail],i)=><li><span>{String(i+1).padStart(2,'0')}</span><h3>{label}</h3><p>{detail}</p></li>)}</ol>
    <div class="nf-boundary-note"><h3>{zh ? "AI 引导过程，模型计算读数。" : "AI guides the process; deterministic models calculate the readings."}</h3><p>{zh ? "实验助手选择目录条目与规范提示卡，由系统组装有依据的解释。数值来自确定性实验模型。记录表与实验计划目前保留在当前会话状态中，不把它们描述为跨会话保存的实验笔记。" : "The assistant selects catalogue entries and canonical hint cards, and the system assembles a grounded explanation. Readings come from deterministic experiment models. Observation tables and plans currently live in session state, rather than a laboratory notebook saved across sessions."}</p></div>
  </div></section>

  <section class="case-section case-section-tinted" id="physics-toolkit"><div class="shell">
    <div class="case-wide-heading"><p class="section-number">{zh ? "物理与数学" : "PHYSICS & MATHEMATICS"}</p><div><h2>{zh ? "世界负责吸引人，学科路径负责让学习继续。" : "The world invites exploration. Subject paths give it structure."}</h2><p>{zh ? "课程与竞赛路径提供进入知识点、题目和方法的入口。地图呈现学习结构，不把目录覆盖等同于已经拥有穷尽的题库。" : "Curriculum and competition paths provide entry points into concepts, questions and methods. A map makes that structure visible; catalogue coverage does not imply an exhaustive question bank."}</p></div></div>
    <div class="nf-subject-grid">
      <article class="nf-subject"><figure class="nf-evidence"><a href={media.physics} target="_blank" rel="noopener noreferrer" aria-label={zh ? "打开物理学习完整截图" : "Open the full physics learning screenshot"}><img src={media.physics} width="1600" height="1000" loading="lazy" decoding="async" alt={zh ? "Ninefold 当前物理学习地图与课程入口" : "Current Ninefold physics learning map and course entry points"}/><span class="nf-image-open" aria-hidden="true">↗</span></a><figcaption>{zh ? "物理天穹 · 当前产品界面" : "Physics learning · Current product interface"}</figcaption></figure><div class="nf-subject-copy"><h3>{zh ? "物理：从入门，到课程与挑战。" : "Physics: from a first encounter to curriculum and challenge."}</h3><p>{zh ? "Beginner、IGCSE、A-Level 与 BPhO / ESAT 四条入口，连接入门探索、4PH1、0625、9702 和进阶挑战；物理史内容属于入门探索。Physics Toolkit 将公式选择、重排、代入和单位拆开，让计算过程可以被检查。" : "The four entry points are Beginner, IGCSE, A-Level and BPhO / ESAT, connecting introductory exploration with 4PH1, 0625, 9702 and advanced challenges. History content sits within the beginner path. The Physics Toolkit separates formula choice, rearrangement, substitution and units so the calculation process can be checked."}</p><a class="text-link" href={productRoute("physics")} target="_blank" rel="noopener noreferrer">{zh ? "进入物理天穹" : "Explore Physics"} <span aria-hidden="true">↗</span></a></div></article>
      <article class="nf-subject"><figure class="nf-evidence"><a href={media.maths} target="_blank" rel="noopener noreferrer" aria-label={zh ? "打开数学学习完整截图" : "Open the full mathematics learning screenshot"}><img src={media.maths} width="1600" height="1000" loading="lazy" decoding="async" alt={zh ? "Ninefold 当前数学课程与竞赛学习入口" : "Current Ninefold mathematics course and competition learning entry points"}/><span class="nf-image-open" aria-hidden="true">↗</span></a><figcaption>{zh ? "数学看板 · 当前产品界面" : "Mathematics learning · Current product interface"}</figcaption></figure><div class="nf-subject-copy"><h3>{zh ? "数学：课程知识、策略课程与题目辅导。" : "Mathematics: curriculum, strategy lessons and question coaching."}</h3><p>{zh ? "IGCSE 0580、0607、0606，Cambridge 9709、9231，以及 UKMT JMC / IMC / SMC 和 AMC 8 / 10 / 12 六条竞赛路径。题目辅导围绕已编写题目运行，并结合确定性的答案与形式检查。" : "IGCSE 0580, 0607 and 0606; Cambridge 9709 and 9231; and six UKMT JMC / IMC / SMC and AMC 8 / 10 / 12 competition profiles. Question coaching works around authored questions, alongside deterministic answer and form checks."}</p><a class="text-link" href={productRoute("maths")} target="_blank" rel="noopener noreferrer">{zh ? "进入数学看板" : "Explore Maths"} <span aria-hidden="true">↗</span></a></div></article>
    </div>
    <div class="nf-practice-note"><h3>{zh ? "练习可以离开屏幕。" : "Practice can leave the screen."}</h3><p>{zh ? "共享练习生成支持 1–10 道题，并分别导出 Questions 与 Answers PDF。系统用受约束的题目配方生成练习，保留数值、解答和分值的一致性。练习用于学习，不是官方考试评分或等级预测。" : "Shared practice generation supports 1–10 questions with separate Questions and Answers PDFs. Bounded question recipes keep numerical values, solutions and marks consistent. This supports learning rather than official examination marking or grade prediction."}</p></div>
  </div></section>

  <section class="case-section" id="ai-boundaries"><div class="shell">
    <div class="case-wide-heading"><p class="section-number">{zh ? "AI 产品编排" : "AI PRODUCT ORCHESTRATION"}</p><div><h2>{zh ? "把模型权限变成明确的产品决策。" : "Make model authority an explicit product decision."}</h2><p>{zh ? "我把语言理解与策略选择交给模型，把可验证的教学内容、数值和判分交给明确的结构与规则。DeepSeek 与 GLM 在这套共享编排中服务于不同学习任务。" : "I assign language interpretation and strategy selection to models, while explicit structures and rules retain verifiable teaching content, numerical truth and marking. DeepSeek and GLM serve different learning tasks within this shared orchestration."}</p></div></div>
    <ol class="nf-orchestration">{orchestration.map(([label,detail],i)=><li><span>{String(i+1).padStart(2,'0')}</span><h3>{label}</h3><p>{detail}</p></li>)}</ol>
    <div class="nf-memory-grid"><article><h3>{zh ? "记住学习证据，少保留原始对话。" : "Keep learning evidence distinct from raw conversation."}</h3><p>{zh ? "数学学习证据与最小题目完成记录在本地保存，例如题目标识、日期、学科、首次作答、是否通过和是否使用支持。角色聊天是暂存对话，不描述成长久记忆。" : "Mathematics evidence and minimal question-completion records are stored locally, including question identifiers, date, subject, first attempt, pass and support state. Character chat is transient conversation, rather than long-term memory."}</p></article><article><h3>{zh ? "可回退，也需要继续验收。" : "Fallback still needs acceptance testing."}</h3><p>{zh ? "规范提示和本地回退让模型失败时仍有受约束的下一步。我把 GLM 可用性、语义质量与响应时间列为持续验收项，并保留故障场景下的明确反馈。" : "Canonical hints and local fallback provide a bounded next step when a model fails. GLM availability, semantic quality and response time remain acceptance criteria, together with clear feedback in failure states."}</p></article></div>
  </div></section>

  <section class="case-section case-section-tinted" id="case-status"><div class="shell">
    <div class="case-wide-heading"><p class="section-number">{zh ? "交付与下一步验证" : "DELIVERY & VALIDATION"}</p><div><h2>{zh ? "已上线的是学习机制，下一步要验证的是学习效果。" : "The learning mechanisms are shipped. Their effect still needs evidence."}</h2><p>{zh ? "公开 Beta 已把角色、语音输入、实验、物理与数学路径，以及原创练习放进同一个双语产品。上线功能与真实学习效果是两种不同的证据。" : "The public beta brings characters, voice input, experiments, physics and mathematics paths, and original practice into one bilingual product. Shipping a feature and demonstrating a learning effect require different evidence."}</p></div></div>
