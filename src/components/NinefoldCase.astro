---
import BaseLayout from "@layouts/BaseLayout.astro";
import { ninefoldLinks } from "@data/ninefold";
import { withBase } from "../utils/urls";

interface Props { locale: "en" | "zh"; }
const { locale } = Astro.props;
const zh = locale === "zh";
const alternate = zh ? "/work/ninefold/" : "/zh/work/ninefold/";
const live = zh ? ninefoldLinks.zh : ninefoldLinks.en;
const copy = zh ? {
  title: "九境生息 Ninefold",
  pageTitle: "九境生息 Ninefold｜30秒视觉微休息产品案例｜张翔 Simon",
  description: "九境生息是一款面向高认知负荷时刻的双语30秒视觉微休息产品。本案例记录四次主要迭代、产品决策、系统逻辑与AI辅助开发过程。",
  eyebrow: "独立产品设计与 AI 辅助开发",
  headline: "让休息先发生，再决定要不要填写任何东西。",
  intro: "我想验证一个很简单的问题：人在已经很累的时候，是否还愿意完成一套冥想、记录或个性化流程？Ninefold 把第一次价值压缩到30秒。用户先进入一个会持续生长的世界，再决定要不要继续塑造它。",
  switchLabel: "Read in English",
  liveLabel: "体验产品",
  role: "独立产品设计 / Product Owner",
  scope: "产品策略、用户研究、交互、AI辅助开发",
  meta: [["角色","独立产品设计 / Product Owner"],["时间","2026.06 – 至今"],["阶段","双语公开 Beta"],["平台","Web · 中文 / English"],["部署","Cloudflare"]],
  snapshot: [["30秒","第一次价值"],["4次","主要版本"],["10+","早期反馈输入"],["9种","世界 / 树身份"],["本地优先","当前数据方式"]],
  sections: {
    problem: "人很累的时候，连“认真休息一下”都可能变成另一项任务。",
    problemBody: ["很多休息产品从目标、内容选择、记录或习惯培养开始。对已经疲惫的用户来说，这些步骤会抬高开始的门槛。我的产品假设更直接：先让用户离开当前思绪30秒，再讨论记录、成长或个性化。", "用户可以零资料开始。第一次停留完成后，一棵没有叶子的树生根；只有以后完成的停留才会长出叶子。短暂停留因此留下可见痕迹，同时不会变成新的任务清单。"],
    jtbd: "当我脑子很满、又不想再完成一项任务时，帮我短暂离开当前思绪，让我更轻松地回来，并看到这次停留留下了一点痕迹。",
    competitionTitle: "定位：低认知投入 × 持续生长的视觉世界",
    competitionIntro: "Ninefold 没有与冥想内容库比内容量，也没有把休息做成生产力计时器。它探索的是更低的首次投入，以及一次次停留如何成为同一个世界的成长记录。",
    evolutionTitle: "四次版本，真正改变的是入口",
    aiTitle: "AI 缩短了决策到原型的距离",
    feedbackTitle: "10+早期反馈如何改变产品",
    learnTitle: "最重要的一次迭代，是把东西拿掉",
    learnBody: "这个项目最后没有变成一个功能越来越多的网站。最重要的一次调整是移除第一次使用前的资料要求，再把人格偏好后移，让30秒体验自己证明价值。对我来说，Ninefold 是一次完整的产品练习：定义问题、做出原型、听到不舒服的反馈，再改掉自己原先认为重要的东西。当前是双语公开 Beta，定性测试仍在继续。"
  }
} : {
  title: "Ninefold",
  pageTitle: "Ninefold — 30-second Visual Micro-Pause Product Case | Simon Zhang",
  description: "Ninefold is a bilingual 30-second visual micro-pause for cognitively overloaded moments. The case covers four major iterations, product logic, user feedback and AI-assisted delivery.",
  eyebrow: "Independent Product Design & AI-Assisted Development",
  headline: "Let the pause happen before asking the user for anything.",
  intro: "I built Ninefold around a simple product question: when someone is already mentally overloaded, how much setup will they tolerate before a break starts feeling like another task? The first value is therefore a 30-second visual pause. Personalisation comes afterwards.",
  switchLabel: "查看中文案例",
  liveLabel: "Try the live beta",
  role: "Independent Product Designer / Product Owner",
  scope: "Product strategy, user research, interaction and AI-assisted build",
  meta: [["Role","Independent Product Designer / Product Owner"],["Timeline","Jun 2026 – Present"],["Stage","Public bilingual beta"],["Platform","Web · ZH / EN"],["Deployment","Cloudflare"]],
  snapshot: [["30 sec","first value"],["4","major versions"],["10+","early feedback inputs"],["9","world / tree identities"],["Local-first","current data model"]],
  sections: {
    problem: "When someone is tired, a well-intended break can still feel like another task.",
    problemBody: ["Many wellbeing products begin with a goal, content choice, check-in or habit system. Those steps can be useful later, but they create commitment before relief. My hypothesis was that the first interaction should ask for almost nothing: step out of the current cognitive stream for 30 seconds, then decide whether the world is worth shaping.", "A user can begin with no personal information. The first completed pause creates a rooted tree with zero leaves. Later completed pauses add leaves, turning return behaviour into visible memory without introducing a checklist or streak obligation."],
    jtbd: "When I am mentally overloaded and do not want another task, help me leave the current cognitive stream briefly, so I can return with less friction and feel that the pause left a trace.",
    competitionTitle: "Positioning hypothesis: low cognitive effort × persistent visual world",
    competitionIntro: "Ninefold does not compete on the size of a meditation library, turn rest into a focus timer, or lead with goals and quests. It explores a deliberately small first commitment and a visual world that remembers every completed pause.",
    evolutionTitle: "Four versions; the entry point was the real product change",
    aiTitle: "AI compressed the distance between a decision and a working prototype",
    feedbackTitle: "How 10+ early feedback inputs changed the product",
    learnTitle: "The most valuable iteration removed something",
    learnBody: "Ninefold did not improve by accumulating features. Its most important change removed personal questions before first value and moved personality choices later. That let the 30-second experience make its own case. The project has been a full product exercise: frame the problem, build a prototype, hear uncomfortable feedback, and change an idea I had previously considered important. The bilingual beta is public and broader qualitative testing continues; I make no product-market-fit claim."
  }
};

const versions = zh ? [
  ["V1","假设","持续世界能让休息与反思更有感觉。","问题","概念解释太多，价值出现太晚。"],
  ["V2","决策","让连续生长动画本身成为体验和奖励。","问题","画面更顺了，入口仍不够清楚。"],
  ["V3","决策","加入星座、云与九种世界，形成渐进式世界构建。","问题","生日和个性化仍挡在第一次价值之前。"],
  ["V4","决策","先30秒，再决定是否个性化。","结果","零资料也能完成第一次体验；简单世界是一条完整路径。"]
] : [
  ["V1","Hypothesis","A persistent world could make reflection tangible.","Problem","The concept needed too much explanation before value appeared."],
  ["V2","Decision","Make continuous growth animation part of the reward.","Problem","The experience became smoother, but entry remained unclear."],
  ["V3","Decision","Add zodiac, cloud archetypes and nine worlds as progressive world-building.","Problem","Birthday and personalisation still blocked first value."],
  ["V4","Decision","Start with 30 seconds, then offer personalisation.","Result","The first pause works with zero data; a simple world remains a complete path."]
];

const decisions = zh ? [
  ["先休息，再个性化","疲惫用户先付出的时间只有30秒。"],["首次生根为0片叶子","创建世界与持续回来代表两种不同价值。"],["每次完成只长1片叶子","叶子记录完成和返回，不奖励停留更久。"],["不设核心连续打卡","休息不该变成义务或内疚来源。"],["本地优先","无需注册，反思数据留在浏览器；代价是暂时没有跨设备同步。"],["每日结果固定","同一日期的象征性内容封存一次，状态修改不会变成反复抽取。"],["核心体验不调用运行时 LLM","确定性逻辑减少延迟、成本与数据传输，也更符合当前任务。"]
] : [
  ["30 seconds before personalisation","The tired user commits only a short period before receiving value."],["First birth equals zero leaves","World creation and earned return behaviour represent different concepts."],["One completion equals one leaf","A leaf records completion and return, not time spent."],["No core streak","Rest should not create obligation or guilt."],["Local-first persistence","No sign-up is required and reflective state stays in the browser; cross-device sync is the trade-off."],["A sealed daily reading","The symbolic result is fixed for the local date, so state edits cannot become rerolls."],["No runtime LLM in the core loop","Deterministic logic avoids model latency, cost and data transfer where generation adds no user value."]
];

const feedback = zh ? [
  ["首次入口不够直接","把世界进程讲清楚，并缩短第一次旅程。"],["选择越多，世界应该越像自己的","加入云、九种世界与渐进式塑造。"],["生日先行与疲惫场景冲突","V4 改为价值优先，个性化全部后移。"],["树的揭示碎裂、布局重叠、种子出现突兀","修正遮罩与布局，并直接移除种子。"]
] : [
  ["The first entry was unclear","Clarify world progression and shorten the first journey."],["The world should feel more personal as choices accumulate","Add clouds, nine identities and progressive world-building."],["Birthday-first conflicted with the tired-user scenario","Make V4 value-first and personalisation optional."],["Tree reveal fragments, overlap and an abrupt seed weakened the scene","Repair the masking and layout, then remove the distracting seed."]
];

const competitors = zh ? [
  ["Kinder World / Finch","轻量自我照顾、目标与宠物奖励","Ninefold 把首次输入压到更低"],["Forest","专注计时形成可见森林","Ninefold 记录休息，不衡量生产力"],["Headspace / Calm","引导内容、冥想、睡眠与声音库","Ninefold 用一个持续世界承接短暂停留"]
] : [
  ["Kinder World / Finch","Small self-care actions, goals and companion rewards","Ninefold lowers initial input"],["Forest","Focus sessions become a visible forest","Ninefold records pauses, not productivity"],["Headspace / Calm","Guided meditation, sleep and content libraries","Ninefold uses one persistent world to hold brief pauses"]
];

const systemRules = zh ? ["情绪1–9 × 精力1–9映射到内部3×3状态","首次生根 = 0片叶子","完成30秒 = +1片叶子","完成5分钟 = +1片叶子","中止 = 0","重绘改变外观，不删除成长","每日象征结果按本地日期固定","React / Vite 客户端；浏览器本地存储；Cloudflare静态部署"] : ["Mood 1–9 × Energy 1–9 map to an internal 3×3 state space","First birth = 0 leaves","Complete 30 seconds = +1 leaf","Complete 5 minutes = +1 leaf","Abort = 0","Redraw changes representation and preserves growth","The symbolic reading is sealed by local date","React / Vite client; browser-local persistence; static Cloudflare deployment"];

const aiSupport = zh ? ["把产品规格转成可运行原型","迭代界面和交互","实现动画并排查问题","辅助测试与部署","提供视觉素材方向"] : ["Translate specifications into working prototypes","Iterate UI and interactions","Implement and debug animation","Support testing and deployment","Explore visual-asset directions"];
const humanOwns = zh ? ["定义用户问题与产品范围","解释反馈并决定删掉什么","设定系统不变量和验收标准","判断隐私与数据方式","决定何处无需运行时 AI","把控最终视觉质量"] : ["Frame the user problem and product scope","Interpret feedback and decide what to remove","Define invariants and acceptance criteria","Choose privacy and data boundaries","Decide where runtime AI is unnecessary","Judge final visual quality"];
---
<BaseLayout title={copy.pageTitle} description={copy.description} pageType="article" locale={zh ? "zh-CN" : "en-GB"}>
  <article class="ninefold-case" lang={zh ? "zh-CN" : "en-GB"}>
    <section class="ninefold-hero">
      <img class="ninefold-hero-bg" src={withBase("/images/ninefold/ninefold-sky.webp")} alt="" />
      <img class="ninefold-hero-tree" src={withBase("/images/ninefold/ninefold-tree.webp")} alt={zh ? "九境生息中一棵生长在天空世界里的树" : "A Ninefold tree growing in a painterly sky world"} />
      <div class="shell ninefold-hero-content">
        <nav class="ninefold-language" aria-label={zh ? "语言切换" : "Language switch"}><a href={withBase(alternate)}>{copy.switchLabel}</a></nav>
        <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><h2>{copy.headline}</h2><p>{copy.intro}</p>
        <div class="button-row"><a class="button button-primary" href={live} target="_blank" rel="noopener noreferrer">{copy.liveLabel} ↗</a><a class="button button-secondary" href="#evolution">{zh ? "查看四次版本" : "See the four versions"}</a></div>
      </div>
    </section>
    <section class="ninefold-ledger"><div class="shell"><dl>{copy.meta.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl><div class="ninefold-snapshot">{copy.snapshot.map(([v,l])=><div><strong>{v}</strong><span>{l}</span></div>)}</div></div></section>
    <section class="case-section"><div class="shell case-section-grid"><header><p class="section-number">01</p><h2>{copy.sections.problem}</h2></header><div class="ninefold-prose">{copy.sections.problemBody.map(p=><p>{p}</p>)}<blockquote><p>{copy.sections.jtbd}</p></blockquote></div></div></section>
    <section class="case-section case-section-tinted"><div class="shell"><div class="case-wide-heading"><p class="section-number">02</p><div><h2>{copy.sections.competitionTitle}</h2><p>{copy.sections.competitionIntro}</p></div></div><div class="ninefold-table" role="table">{competitors.map((r)=><div class="ninefold-table-row" role="row">{r.map(c=><span role="cell">{c}</span>)}</div>)}</div></div></section>
    <section class="case-section" id="evolution"><div class="shell"><div class="case-wide-heading"><p class="section-number">03</p><div><h2>{copy.sections.evolutionTitle}</h2><p>{zh ? "每一版都遵循：假设 → 构建 → 反馈 → 决策 → 学习。" : "Each version followed the same discipline: hypothesis, build, feedback, decision, learning."}</p></div></div><div class="ninefold-timeline">{versions.map(v=><article><span>{v[0]}</span><h3>{v[1]}</h3><p>{v[2]}</p><h3>{v[3]}</h3><p>{v[4]}</p></article>)}</div></div></section>
    <section class="ninefold-visual-band"><div class="shell"><figure><img src={withBase("/images/ninefold/ninefold-world.webp")} alt={zh ? "九境生息的成熟天空与树世界" : "A mature Ninefold sky and tree world"}/><figcaption>{zh ? "一次次完整停留，最终汇入同一个持续生长的世界。" : "Completed pauses accumulate in one persistent world."}</figcaption></figure><figure><img src={withBase("/images/ninefold/ninefold-canopy.webp")} alt={zh ? "九境生息九种世界之一的树冠视觉" : "Canopy artwork from one of Ninefold's nine world identities"}/><figcaption>{zh ? "九种世界让后续个性化有表达空间，第一次体验仍保持简单。" : "Nine identities create room for later expression while first use stays simple."}</figcaption></figure></div></section>
    <section class="case-section case-section-dark"><div class="shell case-section-grid"><header><p class="section-number">04</p><h2>{zh ? "七个关键产品决定" : "Seven product decisions"}</h2></header><ol class="ninefold-decisions">{decisions.map(([t,d],i)=><li><span>{String(i+1).padStart(2,"0")}</span><div><h3>{t}</h3><p>{d}</p></div></li>)}</ol></div></section>
    <section class="case-section"><div class="shell"><div class="case-wide-heading"><p class="section-number">05</p><div><h2>{zh ? "系统如何工作" : "How the system works"}</h2><p>{zh ? "用户看到的是安静的世界，背后是一套明确、可测试的确定性规则。" : "The interface feels calm because the underlying rules are explicit, deterministic and testable."}</p></div></div><div class="ninefold-loop" aria-label="Pause Grow Remember Return"><span>PAUSE</span><i>→</i><span>GROW</span><i>→</i><span>REMEMBER</span><i>→</i><span>RETURN</span></div><ul class="ninefold-rules">{systemRules.map(r=><li>{r}</li>)}</ul></div></section>
    <section class="case-section case-section-tinted"><div class="shell case-section-grid"><header><p class="section-number">06</p><h2>{copy.sections.aiTitle}</h2></header><div><p class="case-lead">{zh ? "AI 提高了执行速度，但没有替代产品判断。" : "AI moved a product decision into prototype form faster; the decisions still needed an owner."}</p><div class="case-columns"><article><h3>{zh ? "Codex / 生成式工具协助" : "Codex / generative tools supported"}</h3><ul class="plain-list">{aiSupport.map(x=><li>{x}</li>)}</ul></article><article><h3>{zh ? "我负责" : "Product ownership remained responsible for"}</h3><ul class="plain-list">{humanOwns.map(x=><li>{x}</li>)}</ul></article></div></div></div></section>
    <section class="case-section"><div class="shell"><div class="case-wide-heading"><p class="section-number">07</p><div><h2>{copy.sections.feedbackTitle}</h2><p>{zh ? "这些输入来自早期体验者和迭代讨论。我用它们发现使用阻力，并调整产品设计。" : "Early users and iteration conversations exposed friction in the experience. I used those inputs to change the product."}</p></div></div><div class="ninefold-feedback">{feedback.map(([p,d])=><article><h3>{p}</h3><p>{d}</p></article>)}</div></div></section>
    <section class="case-section case-section-dark"><div class="shell case-section-grid"><header><p class="section-number">08</p><h2>{copy.sections.learnTitle}</h2></header><div><p class="case-lead">{copy.sections.learnBody}</p><div class="button-row"><a class="button button-primary" href={live} target="_blank" rel="noopener noreferrer">{copy.liveLabel} ↗</a><a class="button button-secondary ninefold-button-light" href={withBase(alternate)}>{copy.switchLabel}</a></div></div></div></section>
    <nav class="shell case-nav" aria-label={zh ? "案例导航" : "Case-study navigation"}><a href={withBase(zh ? "/zh/work/" : "/work/")}><span aria-hidden="true">←</span> {zh ? "全部项目" : "All work"}</a><a href={live} target="_blank" rel="noopener noreferrer">{copy.liveLabel} <span aria-hidden="true">↗</span></a></nav>
  </article>
</BaseLayout>
