---
import BaseLayout from "@layouts/BaseLayout.astro";
import { ninefoldLinks } from "@data/ninefold";
import { withBase } from "../utils/urls";
const { locale = "en" } = Astro.props;
const zh = locale === "zh";
const alternate = zh ? "/work/ninefold/" : "/zh/work/ninefold/";
const live = zh ? ninefoldLinks.zh : ninefoldLinks.en;
const shot = withBase("/images/ninefold-physics/characters.png");
const c = zh ? {
  pageTitle:"Ninefold Physics｜沉浸式物理学习 Agent｜张翔 Simon", description:"Ninefold 是面向国际课程中学生和物理爱好者的沉浸式物理学习 Agent。", switchLabel:"English case", liveLabel:"体验 Ninefold Physics", eyebrow:"旗舰项目 · 沉浸式物理学习 Agent", headline:"和主角一起进入世界，把物理问题想明白", intro:"学生选择二次元主角，在真实情境中观察雨滴、落叶等现象；通过 AI 语音交互与自适应苏格拉底式引导，说出思路、建立模型，再自己解决问题。", flow:["角色入境","观察现象","说出理解","分层引导","构建模型","练习迁移"], meta:[["角色","独立产品负责人"],["对象","国际课程中学生 · 物理爱好者"],["课程","IGCSE · A-Level · ESAT"],["状态","已上线的中英文公开 Beta"]]
} : {
  pageTitle:"Ninefold Physics — Immersive physics-learning agent | Simon Zhang", description:"An immersive physics-learning agent for international-curriculum secondary students and physics enthusiasts.", switchLabel:"中文案例", liveLabel:"Experience Ninefold Physics", eyebrow:"Flagship · Immersive Physics Learning Agent", headline:"Enter a living world. Build the physics yourself.", intro:"Learners choose an anime protagonist and explore rain, falling leaves and other phenomena. AI voice interaction and adaptive Socratic guidance help them observe, reason, model and solve physics problems themselves.", flow:["Choose a role","Observe","Explain","Scaffold","Model","Transfer"], meta:[["Role","Independent product owner"],["Audience","International-curriculum students · enthusiasts"],["Tracks","IGCSE · A-Level · ESAT"],["Status","Live bilingual public beta"]]
};
const paths = zh ? [["理解完整","跳过不必要的提示，直接进入计算或迁移"],["方向正确，缺少一步","只追问缺失的概念"],["存在明确误区","从第一个偏差开始引导"],["信息不足","先澄清，不替学生猜"]] : [["Secure understanding","Skip unnecessary support and move to calculation or transfer"],["Partially complete","Target only the missing concept"],["Clear misconception","Scaffold from the first point of divergence"],["Insufficient evidence","Clarify rather than guess"]];
const toolkit = zh ? ["选择物理领域","选择公式","判断正确重排","代入数值","得到结果","检查单位"] : ["Choose a domain","Choose a relationship","Select the rearrangement","Substitute values","Calculate","Check the unit"];
const tracks = zh ? [["IGCSE Physics","Pearson Edexcel International GCSE Physics 4PH1"],["A-Level Physics","Cambridge International AS & A Level Physics 9702"],["ESAT Physics","UAT-UK ESAT Physics · 学习模式"]] : [["IGCSE Physics","Pearson Edexcel International GCSE Physics 4PH1"],["A-Level Physics","Cambridge International AS & A Level Physics 9702"],["ESAT Physics","UAT-UK ESAT Physics · learning mode"]];
---
<BaseLayout title={c.pageTitle} description={c.description} locale={zh ? "zh-CN" : "en-GB"}>
<article class="ninefold-case physics-case">
  <section class="ninefold-hero physics-hero"><img class="ninefold-hero-bg" src={withBase("/images/ninefold/ninefold-sky.webp")} alt=""/><img class="ninefold-hero-tree" src={withBase("/images/ninefold/ninefold-tree.webp")} alt=""/><div class="shell ninefold-hero-content"><nav class="ninefold-language"><a href={withBase(alternate)}>{c.switchLabel}</a></nav><p class="eyebrow">{c.eyebrow}</p><h1>Ninefold Physics</h1><h2>{c.headline}</h2><p>{c.intro}</p><div class="physics-hero-flow">{c.flow.map((x,i)=><span>{x}{i !== c.flow.length - 1 ? " →" : ""}</span>)}</div><div class="button-row"><a class="button button-primary" href={live} target="_blank" rel="noopener noreferrer">{c.liveLabel} ↗</a><a class="button button-secondary" href={withBase(alternate)}>{c.switchLabel}</a></div></div></section>
  <section class="ninefold-ledger"><div class="shell"><dl>{c.meta.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></div></section>
  <section class="case-section"><div class="shell case-section-grid"><header><p class="section-number">01</p><h2>{zh?"从 Ninefold 到 Ninefold Physics":"From Ninefold to Ninefold Physics"}</h2></header><div class="ninefold-prose"><p>{zh?"Ninefold 最初是一个关于人与动态世界如何持续互动的产品实验。我做了世界塑造、树木生长、语音入境和情境变化，再通过早期用户测试调整入口与交互。":"Ninefold began as an experiment in how people might interact with a persistent living world. I built world construction, tree growth, voice entry and responsive scenes, then refined the entry through early user testing."}</p><p>{zh?"最值得保留的是一套交互语言：用户可以塑造自己的世界，直接说一句话让世界回应，而世界会持续存在。GLM 的 Voice-to-World 也为后来让学生说出完整物理思路打下了基础。":"Its strongest result was an interaction language: users could shape a world, speak naturally to it and see that persistent world respond. The GLM Voice-to-World path also became the foundation for spoken physics reasoning."}</p><blockquote><p>{zh?"真正改变的不是界面，而是问题本身。":"The interface did not need a complete reinvention. The problem did."}</p></blockquote></div></div></section>
  <section class="case-section case-section-tinted"><div class="shell"><div class="case-wide-heading"><p class="section-number">02</p><div><h2>{zh?"答案对不对，并不能告诉我们学生哪里不会":"A final answer does not show where understanding broke down"}</h2><p>{zh?"学生可能画错受力图却碰巧算对，也可能知道 F = ma，却不知道什么时候该用。Ninefold Physics 观察的是理解如何一步步形成。":"A learner may start with the wrong force model and still land on the right number, or know F = ma without knowing when it applies. Ninefold Physics observes how the reasoning is constructed."}</p></div></div><figure class="physics-product-shot"><img src={shot} alt={zh?"Ninefold 当前版本的女孩与男孩主角选择画面":"Current Ninefold character selection showing girl and boy protagonists"}/><figcaption>{zh?"先选主角进入世界，再从真实情境里的运动提出物理问题。":"Choose a protagonist, enter the world, then begin with a physical question grounded in the scene."}</figcaption></figure></div></section>
  <section class="case-section case-section-dark"><div class="shell"><div class="case-wide-heading"><p class="section-number">03</p><div><h2>{zh?"同一个问题，不同的思路走不同的教学路径":"Different reasoning should lead to different teaching paths"}</h2><p>{zh?"学生可以打字，也可以通过语音完整说出理解。GLM 处理开放式表达，教学状态机决定下一步。":"Students can type or speak their reasoning. GLM interprets the open response; the tutoring state machine decides what happens next."}</p></div></div><div class="physics-paths">{paths.map(([s,a])=><article><h3>{s}</h3><p>{a}</p></article>)}</div></div></section>
  <section class="case-section"><div class="shell"><div class="case-wide-heading"><p class="section-number">04</p><div><h2>{zh?"AI 处理模糊的问题，规则守住确定的答案":"Use AI for ambiguity; use rules for truth"}</h2><p>{zh?"模型理解自然语言、识别概念缺口、生成受课程约束的原创练习，并判断解释题中的语义证据。可验证的物理事实不会交给模型猜。":"The model interprets natural language, identifies concept gaps, composes bounded original practice and reads semantic evidence in explanations. Verifiable physics is not left to model judgement."}</p></div></div><div class="physics-boundary"><article><span>AI</span><ul>{(zh?["开放式学生表达","概念缺口与误区","原创题结构","解释题语义证据"]:["Open-ended reasoning","Concept gaps and misconceptions","Original question structures","Semantic evidence in explanations"]).map(x=><li>{x}</li>)}</ul></article><article><span>{zh?"确定性系统":"DETERMINISTIC"}</span><ul>{(zh?["课程范围与公式库","教学状态机","重排、数值与单位","答案与评分边界"]:["Curriculum scope and formula registry","Tutoring state transitions","Rearrangement, values and units","Answer keys and marking boundaries"]).map(x=><li>{x}</li>)}</ul></article></div></div></section>
  <section class="case-section physics-toolkit-section"><div class="shell"><div class="case-wide-heading"><p class="section-number">05</p><div><h2>{zh?"不是只交一个答案，而是把物理一步一步搭出来":"Do not submit only the answer. Build the physics."}</h2><p>{zh?"Physics Toolkit 把计算变成可观察的构建过程。系统能区分规律选择、代数、代入与单位错误，再从真正出现偏差的位置继续。":"The Physics Toolkit makes calculation an observable construction process. It separates principle selection, algebra, substitution and unit errors, then scaffolds the first real divergence."}</p></div></div><div class="toolkit-flow">{toolkit.map((x,i)=><span>{x}{i !== toolkit.length - 1 ? " →" : ""}</span>)}</div><div class="formula-card"><small>F = ma · {zh?"求 a":"solve for a"}</small><strong>A. a = F / m</strong><span>B. a = Fm</span><span>C. a = m / F</span></div></div></section>
  <section class="case-section case-section-tinted"><div class="shell"><div class="case-wide-heading"><p class="section-number">06</p><div><h2>{zh?"从理解一个现象，到证明自己真的会用":"Move from understanding a phenomenon to proving it transfers"}</h2><p>{zh?"完成 Rain 或 Leaf 的概念探索后，学生进入四道课程对齐原创练习：核心概念、应用、易错点与新情境迁移。":"After Rain or Leaf, learners continue into four original curriculum-aware questions: core concept, application, misconception check and transfer."}</p></div></div><div class="physics-tracks">{tracks.map(([n,d])=><article><h3>{n}</h3><p>{d}</p></article>)}</div><p class="integration-note">{zh?"课程对齐与原创出题层沿用了我此前 Personalised Practice Generator 中的 curriculum resolver、题目蓝图与确定性校验思路，并改造成适合实时交互的学习流程。":"The curriculum and question-generation layer evolved from my earlier Personalised Practice Generator, reusing its curriculum resolver, question-blueprint and deterministic-validation ideas in a real-time tutoring flow."}</p></div></section>
  <section class="case-section"><div class="shell"><div class="case-wide-heading"><p class="section-number">07</p><div><h2>{zh?"不同的题，看到不同的思考过程":"Different question types reveal different forms of thinking"}</h2><p>{zh?"选择题用干扰项定位典型误区；解释题支持语音转写、编辑和确认后评分；计算题记录 Toolkit 的完整构建过程。":"MCQ distractors point to common misconceptions; spoken explanations are transcribed, edited and confirmed before marking; calculations preserve the complete Toolkit trace."}</p></div></div><div class="question-types"><article><b>MCQ</b><h3>{zh?"选择题":"Multiple choice"}</h3><p>{zh?"干扰项也成为下一步教学的证据。":"Distractors become evidence for the next scaffold."}</p></article><article><b>VOICE + TEXT</b><h3>{zh?"解释题":"Explanation"}</h3><p>{zh?"学生确认可编辑文字后再评分。":"Learners confirm editable text before assessment."}</p></article><article><b>TOOLKIT</b><h3>{zh?"计算题":"Calculation"}</h3><p>{zh?"记录公式、重排、代入、结果和单位。":"Capture formula, rearrangement, substitution, result and unit."}</p></article></div></div></section>
  <section class="case-section case-section-dark"><div class="shell"><div class="case-wide-heading"><p class="section-number">08</p><div><h2>{zh?"给分和教学，是两件不同的事":"Marking and teaching serve different purposes"}</h2><p>{zh?"系统保留第一次独立作答，再根据失分位置继续教学。计算题尽量用确定性规则检查过程；解释题按预先生成并校验的 marking points 判断已确认文本。":"The system preserves the first independent attempt, then teaches from the lost mark. Calculation traces are checked deterministically where possible; explanations use pre-generated, validated marking points."}</p></div></div><div class="mark-card"><strong>{zh?"首次作答：2 / 3":"First attempt: 2 / 3"}</strong><span>✓ {zh?"阻力随速度增大":"Drag increases with speed"}</span><span>✓ {zh?"阻力最终可与重力平衡":"Drag can eventually balance weight"}</span><span>△ {zh?"仍需区分加速度为零与速度为零":"Distinguish zero acceleration from zero velocity"}</span></div><p class="practice-disclaimer">{zh?"Board-informed practice marking 用于学习反馈，不是 Pearson、Cambridge International 或 UAT-UK 的官方评分，也不换算正式等级或 ESAT scaled score。":"Board-informed practice marking supports learning. It is not official Pearson, Cambridge International or UAT-UK assessment and is not converted into grades or an ESAT scaled score."}</p></div></section>
  <section class="case-section"><div class="shell case-section-grid"><header><p class="section-number">09</p><h2>{zh?"当前状态与边界":"Current status and boundaries"}</h2></header><div class="ninefold-prose"><p>{zh?"公开 Beta 已包含 Rain / Leaf、三条课程路径、语音与文字推理、自适应 Socratic scaffold、原创练习、Physics Toolkit、过程化评分、AI 回退，以及中英文移动端适配。":"The public beta includes Rain and Leaf, three learning tracks, voice and text reasoning, adaptive Socratic scaffolding, original practice, the Physics Toolkit, process-aware assessment, AI fallback and bilingual mobile support."}</p><p>{zh?"当前仍是早期产品。开放式判断具有概率性；动画用于教学表达，不是完整仿真；练习是原创 exam-style practice，不是官方真题。下一步将用真实学生验证完成率、诊断质量、提示有效性和知识迁移。":"This remains an early product. Open-ended interpretation is probabilistic; animation is pedagogical rather than a full simulation; practice is original, not official past-paper content. The next milestone is evidence from real learners on completion, diagnosis, scaffold usefulness and transfer."}</p><div class="button-row"><a class="button button-primary" href={live} target="_blank" rel="noopener noreferrer">{c.liveLabel} ↗</a></div></div></div></section>
</article>
</BaseLayout>
