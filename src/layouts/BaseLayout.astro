---
import SiteFooter from "@components/SiteFooter.astro";
import SiteHeader from "@components/SiteHeader.astro";
import { site } from "@data/site";
import { withBase } from "../utils/urls";
import "@styles/global.css";

interface Props {
  title: string;
  onePage?: boolean;
  description?: string;
  image?: string;
  pageType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
  locale?: "en-GB" | "zh-CN";
}

const {
  title,
  onePage = false,
  description = site.description,
  image = site.socialImage,
  pageType = "website",
  structuredData,
  noIndex = false,
  locale = "en-GB"
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).href;
const socialImageUrl = new URL(withBase(image), baseUrl).href;
const pageTitle = title === site.displayName ? title : title + " | " + site.displayName;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} style={`--portrait-mask:url('${withBase('/images/v2/portrait-mask.svg?v=20261005-rounded')}')`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#142331" />
    {noIndex && <meta name="robots" content="noindex, follow" />}

    <link rel="canonical" href={canonicalUrl} />
    {(Astro.url.pathname === withBase('/') || Astro.url.pathname === withBase('/zh/')) && <link rel="preload" as="image" href={withBase('/media/cosmic-run/simon-entry.svg?v=canonical-lock-6')} fetchpriority="high" />}
    <link rel="icon" href={withBase("/icons/favicon.svg")} type="image/svg+xml" />

    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content={locale === "zh-CN" ? "zh_CN" : "en_GB"} />
    <meta property="og:site_name" content={site.displayName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Xiang Zhang — AI Product and Applied AI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script is:inline>document.documentElement.classList.add("js");</script>
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body data-one-page={onePage ? "true" : undefined}>
    <a class="skip-link" href="#main-content">{locale === "zh-CN" ? "跳到主要内容" : "Skip to main content"}</a>
    <SiteHeader currentPath={currentPath} locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} sceneCredits={onePage} />
    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (!reducedMotion.matches && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          });
        }, { rootMargin: "0px 0px -24px 0px", threshold: 0.05 });
        revealTargets.forEach((element) => observer.observe(element));
      }
      // Only the visible scene layers move, by at most 16px; all content scrolls normally.
      const layers = Array.from(document.querySelectorAll<HTMLElement>("[data-depth]"));
      const visible = new Set<HTMLElement>();
      let pending = false;
      const paintDepth = () => {
        pending = false;
        if (reducedMotion.matches) return;
        visible.forEach((layer) => {
          const rect = layer.parentElement?.getBoundingClientRect();
          if (!rect) return;
          const amount = Math.min(16, Number(layer.dataset.depth) || 12);
          const progress = Math.max(-1, Math.min(1, (window.innerHeight / 2 - rect.top - rect.height / 2) / window.innerHeight));
          layer.style.transform = `translate3d(0,${(progress * amount).toFixed(1)}px,0)`;
        });
      };
      const queueDepth = () => { if (!pending && !reducedMotion.matches && visible.size) { pending = true; requestAnimationFrame(paintDepth); } };
      if (layers.length && "IntersectionObserver" in window) {
        const depthObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => entry.isIntersecting ? visible.add(entry.target as HTMLElement) : visible.delete(entry.target as HTMLElement));
          queueDepth();
        });
        layers.forEach((layer) => depthObserver.observe(layer));
        window.addEventListener("scroll", queueDepth, { passive: true });
        reducedMotion.addEventListener("change", () => { layers.forEach((layer) => layer.style.removeProperty("transform")); queueDepth(); });
      }
    </script>
  </body>
</html>
