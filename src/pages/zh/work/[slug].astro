---
import type {GetStaticPaths} from "astro"; import BaseLayout from "@layouts/BaseLayout.astro"; import PageHero from "@components/PageHero.astro"; import FlowDiagram from "@components/FlowDiagram.astro"; import ContactPanel from "@components/ContactPanel.astro"; import {projects} from "@data/zh/projects"; import type {CaseStudy} from "@data/en/projects"; import {withBase} from "../../../utils/urls";
export const getStaticPaths=(() => projects.filter(p=>p.slug!=="ninefold").map(project=>({params:{slug:project.slug},props:{project}}))) satisfies GetStaticPaths;
const {project}=Astro.props as {project:CaseStudy};
---
<BaseLayout locale="zh-CN" title={project.title} description={project.summary} pageType="article"><PageHero eyebrow={project.kicker} title={project.title} intro={project.summary} meta={[project.period,project.organisation,project.status]}/>
<section class="case-overview section"><div class="shell case-overview-grid"><div><p class="eyebrow">项目概览</p><h2>{project.question}</h2></div><dl class="case-ledger"><div><dt>场景</dt><dd>{project.organisation}</dd></div><div><dt>时间</dt><dd>{project.period}</dd></div><div><dt>状态</dt><dd>{project.status}</dd></div></dl></div></section>
<section class="case-section"><div class="shell case-section-grid"><header><p class="section-number">01</p><h2>用户与场景</h2></header><div class:list={["case-columns",project.constraints.length===0&&"case-columns-single"]}><article><h3>用户与利益相关者</h3><ul class="plain-list">{project.users.map(x=><li>{x}</li>)}</ul></article>{project.constraints.length>0&&<article><h3>工作条件</h3><ul class="plain-list">{project.constraints.map(x=><li>{x}</li>)}</ul></article>}</div></div></section>
<section class="case-section case-section-tinted"><div class="shell case-section-grid"><header><p class="section-number">02</p><h2>我的工作与关键判断</h2></header><div><p class="case-lead">{project.role}</p><ol class="decision-list">{project.decisions.map((x,i)=><li><span>{String(i+1).padStart(2,"0")}</span><p>{x}</p></li>)}</ol></div></div></section>
<section class="case-section"><div class="shell"><header class="case-wide-heading"><p class="section-number">03</p><div><h2>工作流</h2><p>这张图展示主要步骤和决策节点。</p></div></header><FlowDiagram steps={project.workflow}/></div></section>
<section class="case-section case-section-dark"><div class="shell case-section-grid"><header><p class="section-number">04</p><h2>评估与结果</h2></header><div class="case-columns"><article><h3>如何评估</h3><ul class="plain-list">{project.evaluation.map(x=><li>{x}</li>)}</ul></article><article><h3>完成了什么</h3><ul class="plain-list">{project.outcomes.map(x=><li>{x}</li>)}</ul></article></div></div></section>
<section class="case-section"><div class="shell case-section-grid"><header><p class="section-number">05</p><h2>复盘</h2></header><div>{project.limitations.length>0&&<ul class="limitation-list">{project.limitations.map(x=><li>{x}</li>)}</ul>}<blockquote><p>{project.learning}</p></blockquote>{project.relatedResearch&&<p class="related-line"><strong>相关研究：</strong>{project.relatedResearch}</p>}{project.links&&<div class="case-links">{project.links.map(l=><a class="text-link" href={l.href}>{l.label} ↗</a>)}</div>}<div class="tag-list">{project.capabilities.map(x=><span>{x}</span>)}</div></div></div></section>
<nav class="shell case-nav"><a href={withBase("/zh/work/")}>← 全部项目</a><a href={withBase("/zh/contact/")}>联系我 →</a></nav><div class="shell section"><ContactPanel locale="zh-CN" title="想了解这个项目背后的判断？"/></div></BaseLayout>
