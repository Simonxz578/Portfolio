---
import BaseLayout from "@layouts/BaseLayout.astro";
import CosmicRunHero from "@components/CosmicRunHero.astro";
import OnePageResume from "@components/OnePageResume.astro";
import {site} from "@data/site";
import {withBase} from "../../utils/urls";
const personSchema={"@context":"https://schema.org","@type":"Person",name:site.name,alternateName:"张翔 Simon",url:new URL(withBase('/zh/'),Astro.site??Astro.url.origin).href,jobTitle:site.role,sameAs:[site.linkedin,site.github],alumniOf:[{"@type":"CollegeOrUniversity",name:"University of Cambridge"},{"@type":"CollegeOrUniversity",name:"University College London"},{"@type":"CollegeOrUniversity",name:"University of Manchester"}]};
---
<BaseLayout locale="zh-CN" title="张翔 Simon｜AI产品与应用AI" description="张翔的完整单页履历与作品集：物理、AI产品、应用AI、教育研究与组织领导力。" structuredData={personSchema} onePage>
  <CosmicRunHero locale="zh" />
  <OnePageResume locale="zh" />
</BaseLayout>
