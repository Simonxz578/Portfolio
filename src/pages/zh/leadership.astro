---
import BaseLayout from "@layouts/BaseLayout.astro"; import PageHero from "@components/PageHero.astro"; import ContactPanel from "@components/ContactPanel.astro";
const items=[
 {title:"Cambridge CEO",role:"联合创始人 · 社群与项目运营",period:"2026年1月至今",summary:"共同创办剑桥创业社群，参与组织设计、项目规划、对外沟通和活动交付。",points:["参与搭建早期组织结构与项目方向","协调学生、创业者、投资人和技术团队的不同需求","推进活动沟通、资源、跟进与现场交付"],links:[{href:"https://www.cambridgeceo.org/",label:"访问 Cambridge CEO"}]},
 {title:"Formal Hall Networking Society",role:"创始人及创始主席",period:"2025–2026",summary:"创办剑桥跨学院社群，搭建委员会、活动流程、沟通渠道、网站和换届机制。",points:["建立团队分工与治理规则","整理报名、名额、付款、饮食需求、场地和现场交付流程","负责协会网站的产品定位、AI辅助开发、测试与上线","完成下一任主席交接，为后续团队留下可复用结构"],links:[{href:"https://camformal.com/",label:"访问协会网站"}]}
];
---
<BaseLayout locale="zh-CN" title="领导力" description="张翔在剑桥创业与跨学院社群中的组织搭建、运营和产品交付经历。"><PageHero eyebrow="领导力" title="我把想法变成团队可以持续推进的工作。" intro="我的领导经历包括组织从0到1、活动运营、跨团队协作、数字产品交付和换届交接。" meta={["社群搭建","项目运营","数字产品"]}/><section class="section"><div class="shell leadership-list">{items.map((x,i)=><article><div class="leadership-number">{String(i+1).padStart(2,"0")}</div><header><p class="eyebrow">{x.period}</p><h2>{x.title}</h2><p class="leadership-role">{x.role}</p></header><div><p class="leadership-summary">{x.summary}</p><ul class="plain-list">{x.points.map(p=><li>{p}</li>)}</ul><div class="leadership-links">{x.links.map(l=><a class="text-link" href={l.href}>{l.label} ↗</a>)}</div></div></article>)}</div></section><section class="section section-ink"><div class="shell website-story"><div><p class="eyebrow">0→1产品交付</p><h2>把协会创始年的工作整理成可以继续使用的系统。</h2></div><div><p>我先跑通真实活动，再把团队分工、报名、付款、场地、沟通和现场交付整理成流程。</p><p>随后我负责camformal.com的产品定位、内容架构和上线。Codex协助代码实现和重复测试，我负责事实、隐私、设计、验收与发布。</p><p>后续团队可以沿用现有组织、流程和网站继续运营，无需从头开始。</p><p><a class="text-link" href="https://camformal.com/">访问网站 ↗</a></p></div></div></section><div class="shell section"><ContactPanel locale="zh-CN" title="需要推动一个跨团队项目？"/></div></BaseLayout>
