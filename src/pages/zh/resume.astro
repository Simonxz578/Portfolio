---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactPanel from "@components/ContactPanel.astro";
import PageHero from "@components/PageHero.astro";
import { site } from "@data/site";
const experience = [
  { period:"2025–2026", organisation:"剑桥大学", role:"硕士研究 · AI政策与教师能动性", summary:"研究AI政策和学校层面的指引如何进入教师的专业实践。" },
  { period:"2025", organisation:"Harris St John’s Wood，伦敦", role:"科学（物理）教师", summary:"参与真实课堂教学、课堂观察，并根据学生反馈调整教学。" },
  { period:"2024–2025", organisation:"伦敦大学学院", role:"硕士研究 · AI与科学教育", summary:"研究教师使用AI的信心和教学方式，相关论文正在修改。" },
  { period:"2024", organisation:"经纬恒润，北京", role:"硬件工程实习生 · LLM工作流", summary:"参与模型部署、评估、RAG检索和Agent工作流在工业场景中的集成。" },
  { period:"2023", organisation:"西门子，北京", role:"材料工程实习生", summary:"分析医疗导管材料数据，并用Python辅助工程分析与决策。" }
];
const education = [
  { period:"2025–2026", institution:"剑桥大学", degree:"教育学硕士（教育政策、领导力与改进）" },
  { period:"2024–2025", institution:"伦敦大学学院", degree:"教育学硕士（科学教育）" },
  { period:"2020–2023", institution:"曼彻斯特大学", degree:"物理学荣誉学士" }
];
const capabilities = [
  { group:"应用AI", items:["LLM部署","RAG","Agent工作流","API集成","多模态流程","模型评估"] },
  { group:"产品", items:["用户研究","工作流分析","产品设计","采用与信任","真实用户反馈"] },
  { group:"研究", items:["定性研究","研究综合","政策分析","评估设计","利益相关者分析"] },
  { group:"领导力", items:["社群建设","项目运营","项目交付","跨团队协作","交接规划"] }
];
---
<BaseLayout locale="zh-CN" title="履历" description="张翔的应用AI、研究、产品与领导力经历。">
  <PageHero eyebrow="履历" title="与AI产品最相关的经历。" intro="这份简明履历集中呈现我的应用AI、研究、产品和领导力实践。" meta={["中文","代表经历","AI产品"]}/>
  <section class="section"><div class="shell resume-layout">
    <aside class="resume-aside"><p class="eyebrow">简介</p><h2>AI产品与应用AI</h2><p>应用AI、模型工作流、用户研究、评估和组织采用。</p><div class="resume-pending"><strong>索取完整履历</strong><p>如需针对具体岗位的完整版本，请直接联系我。</p><a class="text-link" href={"mailto:"+site.email}>发送邮件 <span>→</span></a></div></aside>
    <div class="resume-main">
      <section><h2>代表经历</h2><ol class="resume-list">{experience.map(item=><li><time>{item.period}</time><div><h3>{item.role}</h3><p class="resume-org">{item.organisation}</p><p>{item.summary}</p></div></li>)}</ol></section>
      <section><h2>教育经历</h2><ol class="resume-list compact">{education.map(item=><li><time>{item.period}</time><div><h3>{item.degree}</h3><p class="resume-org">{item.institution}</p></div></li>)}</ol></section>
      <section><h2>能力</h2><div class="resume-capabilities">{capabilities.map(group=><article><h3>{group.group}</h3><p>{group.items.join(" · ")}</p></article>)}</div></section>
    </div>
  </div></section>
  <div class="shell section"><ContactPanel locale="zh-CN" title="需要针对岗位的完整履历？" copy="请在邮件中告诉我岗位或具体问题，我会分享相应版本。"/></div>
</BaseLayout>
