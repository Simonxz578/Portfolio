---
import "../../styles/editorial.css";
import BaseLayout from "@layouts/BaseLayout.astro"; import PageHero from "@components/PageHero.astro"; import ContactPanel from "@components/ContactPanel.astro"; import {withBase} from "../../utils/urls";
---
<BaseLayout locale="zh-CN" title="关于我" description="张翔：从物理和系统思维走向应用AI、产品与教育研究。">
<div class="editorial-page editorial-about"><PageHero variant="about" eyebrow="关于我" title="物理教会我理解系统，AI让我把人放回系统中心。" intro="我关注技术能力如何进入用户判断、组织流程和真实决策。" meta={["剑桥","伦敦","北京"]}/>
<section class="section editorial-reading"><div class="shell about-story"><figure><img src={withBase("/images/v2/simon-cambridge-seated.jpg")} width="800" height="1200" loading="lazy" decoding="async" alt="张翔在剑桥学院建筑旁"/><figcaption>剑桥 · 思考、实践与连接。</figcaption></figure><div class="prose"><h2>我的路径</h2><p>我在曼彻斯特大学学习物理，训练了建模、实验和数据分析能力。后来，我把这种系统思维带入工业AI、教育研究和产品开发。</p><p>在经纬恒润，我参与语言模型部署、RAG检索和Agent工作流。在伦敦大学学院与剑桥大学，我研究教师如何理解、信任和采用AI。这些经历让我能够同时讨论模型表现、用户任务和组织条件。</p><p>我也创办并运营剑桥跨学院社群，负责团队、活动流程、网站和交接。它让我真正理解：产品经理需要推动人、信息与执行共同向前。</p><h2>我正在寻找</h2><p>我希望加入重视用户问题、技术判断和快速交付的AI产品团队，参与从问题定义到上线迭代的完整过程。</p></div></div></section>
<section class="section section-warm">
  <div class="shell education-grid">
    <div><p class="eyebrow">教育经历</p><h2>三种学科，一条连续的路径。</h2></div>
    <ol>
      <li><span>01</span><div><time>2025–2026</time><h3>剑桥大学</h3><p>教育学（教育政策、领导力与改进）哲学硕士</p></div></li>
      <li><span>02</span><div><time>2024–2025</time><h3>伦敦大学学院</h3><p>教育学（科学）文学硕士</p></div></li>
      <li><span>03</span><div><time>2020–2023</time><h3>曼彻斯特大学</h3><p>物理学理学学士</p></div></li>
    </ol>
  </div>
</section>
<section class="section">
  <div class="shell value-grid">
    <article><span>01</span><h2>能力</h2><p>模型和周边系统实际上能做什么？</p></article>
    <article><span>02</span><h2>使用</h2><p>哪些决策、任务或工作流值得支持？</p></article>
    <article><span>03</span><h2>证据</h2><p>如何判断系统是否有用、可信并被采用？</p></article>
  </div>
</section>
<div class="shell section"><ContactPanel locale="zh-CN" title="一起做真正有用的AI产品。"/></div></div>
</BaseLayout>
