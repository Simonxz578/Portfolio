---
import BaseLayout from "@layouts/BaseLayout.astro";
import CosmicRunHero from "@components/CosmicRunHero.astro";
import OnePageResume from "@components/OnePageResume.astro";
import {site} from "@data/site";
import {withBase} from "../utils/urls";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: "Simon Zhang",
  url: new URL(withBase("/"), Astro.site ?? Astro.url.origin).href,
  jobTitle: site.role,
  knowsAbout: [
    "Applied artificial intelligence",
    "AI product management",
    "Large language model workflows",
    "Retrieval-augmented generation",
    "Model evaluation",
    "Organisational AI adoption"
  ],
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "University of Cambridge"
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University College London" },
    { "@type": "CollegeOrUniversity", name: "University of Manchester" }
  ],
  sameAs: [site.linkedin, site.github]
};
---
<BaseLayout title={site.displayName} description="Xiang Zhang (Simon): AI product, applied AI, physics, education research and organisational leadership. Explore the work and complete résumé on one page." structuredData={personSchema} onePage>
  <CosmicRunHero locale="en" />
  <OnePageResume locale="en" />
</BaseLayout>
