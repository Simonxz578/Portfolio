---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactPanel from "@components/ContactPanel.astro";
import PageHero from "@components/PageHero.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SectionIntro from "@components/SectionIntro.astro";
import { projects } from "@data/en/projects";
---

<BaseLayout
  title="Work"
  description="Selected applied AI, model-workflow, user-research and organisational-adoption case studies by Xiang Zhang."
>
  <PageHero
    eyebrow="Work / Projects"
    title="From model capability to working context."
    intro="Each case shows the problem I found, the choices I made, the work I moved forward and what the project produced."
    meta={["5 selected case studies", "Applied AI", "Research translated for product"]}
  />

  <section class="section">
    <div class="shell">
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section-ink">
    <div class="shell evidence-grid">
      <SectionIntro
        eyebrow="How I work"
        title="Make the problem clear. Make the decisions useful."
        description="Across technical, research and community projects, I use the same practical product discipline."
      />
      <div class="evidence-points">
        <article>
          <span>01</span>
          <h3>Find the real problem</h3>
          <p>Start with the people, the task and the point where the current experience breaks down.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Choose the scope</h3>
          <p>Define what matters for the first useful version and make trade-offs visible to the team.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Test the whole workflow</h3>
          <p>Review the model, interface, hand-offs and user decisions as one connected product experience.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="shell section">
    <ContactPanel title="Have a workflow worth examining?" />
  </div>
</BaseLayout>
